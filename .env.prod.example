# Required environment variables for docker-compose.prod.yml on Dokploy.
#
# Copy this file to `.env` (in the same directory as docker-compose.prod.yml)
# and fill in real values. Dokploy will manage this file via its UI; this
# template is the canonical reference for what must be set.

# --- Database ---
POSTGRES_USER=splashh
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=splashh
DATABASE_URL=postgresql+asyncpg://splashh:change-me-strong-password@postgres:5432/splashh

# --- Cache / queue ---
REDIS_URL=redis://redis:6379/0

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=splashh

# --- Public hostnames (Dokploy will wire these to Traefik) ---
DOMAIN_WEB=yourdomain.com
DOMAIN_API=api.yourdomain.com

# --- JWT ---
# HS256 uses a shared secret (simpler); RS256 uses an RSA keypair.
JWT_ALGORITHM=RS256

# --- CORS ---
# JSON array string. Include both the production and any preview URLs.
CORS_ALLOWED_ORIGINS=["https://yourdomain.com"]

# --- App URL ---
# Base URL of the frontend application (used for payment link redirects)
APP_URL=https://yourdomain.com

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
PAYMENTS_PROVIDER=razorpay

# --- JWT key files (only used when JWT_ALGORITHM=RS256) ---
# Place the PEM files at ./secrets/jwt_private.pem and ./secrets/jwt_public.pem
# relative to docker-compose.prod.yml. The compose file mounts them at
# /run/secrets/jwt_private.pem and /run/secrets/jwt_public.pem.
