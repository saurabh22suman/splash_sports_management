# Splashh Sports Platform — local dev environment
# Copy to .env and adjust as needed. Never commit .env.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://splashh:splashh_dev@localhost:5432/splashh

# Cache / queue
REDIS_URL=redis://localhost:6379/0

# JWT — RS256 keypair. Generate with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Outbound webhooks (SSRF allowlist)
SSRF_ALLOWED_HOSTS=api.razorpay.com,api.stripe.com
